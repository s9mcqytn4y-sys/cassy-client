{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: Dev Server (:3000)",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/cassy-web run dev",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Web: Typecheck & Production Build",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/cassy-web run typecheck && pnpm --filter @azuredevid/cassy-web run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Web: Playwright E2E Tests",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/cassy-web test:e2e",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Design Tokens: Verify WCAG AA & i18n",
      "type": "shell",
      "command": "node packages/design-tokens/verify-tokens.mjs",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble DevDebug APK",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android assembleDevDebug --no-daemon --max-workers=2",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Build DevDebug App Bundle (AAB)",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android bundleDevDebug --no-daemon --max-workers=2",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Run DevDebug Unit Tests",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android testDevDebugUnitTest --no-daemon --max-workers=2",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Launch Cassy Tablet Emulator (Medium_Tablet)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd Medium_Tablet -gpu host -accel on -memory 4096",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Android: Install DevDebug APK via ADB",
      "type": "shell",
      "command": "adb install -r apps/android/app/build/outputs/apk/dev/debug/app-dev-debug.apk",
      "dependsOn": "Android: Assemble DevDebug APK",
      "problemMatcher": []
    },
    {
      "label": "iOS: Verify Objective-C Hardware Bridge",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File apps/ios/scripts/Verify-ObjCSyntax.ps1",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
