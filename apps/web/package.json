{
  "name": "@azuredevid/cassy-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "codegen:api": "openapi-typescript ../../../CassyBackend/docs/Api/OpenApi.yaml -o src/types/api.generated.ts",
    "check:copy": "node scripts/CheckHardcodedCopy.mjs",
    "test:unit": "node --experimental-strip-types src/features/order/cart.test.mjs && node --experimental-strip-types src/lib/plans.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "lucide-react": "^1.77.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2"
  }
}
