<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Staging flavor permits cleartext HTTP on local network / staging LAN appliances. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
