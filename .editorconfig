root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,java,ps1}]
indent_style = space
indent_size = 4

[*.{m,h,mm,swift}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,json,jsonc,css,yml,yaml,sh}]
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
